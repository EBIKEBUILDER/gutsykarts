# Gutsy Karts 3D — Optional Online Multiplayer Configuration
# ----------------------------------------------------------------------------
# NOTE: If these variables are omitted (e.g. when running a local fork),
# Gutsy Karts runs 100% error-free in Single-Player and Local Cross-Tab Mode!
#
# To enable global player-hosted lobbies via Supabase Realtime (Presence + Broadcast):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional TURN relay server for strict 5G/LTE Symmetric NATs:
# (Even without TURN, Supabase Realtime Broadcast automatically relays packets!)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
